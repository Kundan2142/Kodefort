# Environment variables
# Copy this file to .env and fill in the values

# Database URL - use SQLite for local development, PostgreSQL for production
# Local (SQLite): file:./dev.db
# Production (PostgreSQL): postgresql://user:password@host:port/dbname
DATABASE_URL="file:./dev.db"

# Direct URL for Prisma Migrate (only needed for PostgreSQL with connection pooling)
# DIRECT_URL="postgresql://user:password@host:port/dbname"

# JWT Secret Key - generate a secure secret for production
JWT_SECRET="your-secret-key-here-change-in-production"

# Razorpay Credentials
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"
NEXT_PUBLIC_RAZORPAY_KEY_ID="your-razorpay-key-id"
