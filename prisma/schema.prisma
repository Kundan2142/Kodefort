// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Feedback {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

model Admin {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  name         String
  role         String    @default("super_admin")
  createdAt    DateTime  @default(now())

  approvals    CertificateApproval[]
}

model Student {
  id           Int          @id @default(autoincrement())
  name         String
  collegeName  String
  registrationNo String    @unique
  email        String
  mobileNo     String
  dateOfBirth  DateTime
  session      String
  degree       String?
  subject      String?
  internshipType String    @default("Hybrid (Online)")
  enrollments  Enrollment[]
  approvals    CertificateApproval[]
  createdAt    DateTime     @default(now())
}

model Internship {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String
  price       Int          @default(499) // 499 INR
  difficulty  String       @default("Beginner")
  icon        String       @default("💻")
  rating      Float        @default(4.9)
  tasks       Task[]
  enrollments Enrollment[]
  createdAt   DateTime     @default(now())
}

model Enrollment {
  id           Int               @id @default(autoincrement())
  studentId    Int
  internshipId Int
  student      Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internship   Internship        @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  payment      Payment?
  completedTasks CompletedTask[]
  createdAt    DateTime          @default(now())

  @@unique([studentId, internshipId])
}

model CertificateApproval {
  id               Int       @id @default(autoincrement())
  registrationNo   String
  studentName      String
  collegeName    String
  internshipTopic  String    @default("Web Development")
  status           String    @default("pending") // pending | approved | rejected
  degree           String?
  session          String?
  subject          String?
  email            String?
  mobileNo         String?
  address          String?
  approvedBy       Int?
  approvedAt         DateTime?
  remarks          String?
  admin            Admin?    @relation(fields: [approvedBy], references: [id])
  student          Student?  @relation(fields: [registrationNo], references: [registrationNo], onDelete: Cascade)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([registrationNo, internshipTopic])
  @@index([status])
  @@index([registrationNo])
}

model CompletedTask {
  id           Int       @id @default(autoincrement())
  enrollmentId Int
  taskId       Int
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  task         Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  completedAt  DateTime  @default(now())

  @@unique([enrollmentId, taskId])
}

model Payment {
  id           Int       @id @default(autoincrement())
  enrollmentId Int       @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  amount       Int       @default(500)
  status       String    @default("pending") // pending, completed, failed
  orderId      String?
  paymentId    String?
  receiptNo    String?   @unique
  createdAt    DateTime  @default(now())
}

model Task {
  id           Int               @id @default(autoincrement())
  internshipId Int
  internship   Internship        @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  title        String
  description  String
  youtubeUrl   String?
  order        Int
  completedTasks CompletedTask[]
  createdAt    DateTime          @default(now())
}
